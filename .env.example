# LLM provider: groq | gemini | claude | mistral | ollama
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Optional: Gemini (if using LLM_PROVIDER=gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash-preview-05-20

# Optional: Claude (if using LLM_PROVIDER=claude)
ANTHROPIC_API_KEY=your_anthropic_key_here
CLAUDE_MODEL=claude-sonnet-4-6

# Google Play Store apps to monitor — package names or full Play Store URLs (comma-separated)
# Examples: com.wealthfront, com.public.app, com.acorns.android, com.spotify.music, com.duolingo
APPS_TO_MONITOR=https://play.google.com/store/apps/details?id=com.wealthfront,https://play.google.com/store/apps/details?id=com.public.app,https://play.google.com/store/apps/details?id=com.acorns.android

# Scraping & refresh settings
MAX_REVIEWS_PER_APP=50
MAX_AGE_HOURS=24

# Dashboard
DASHBOARD_PORT=5000
DATA_FILE=data/app_data.json
